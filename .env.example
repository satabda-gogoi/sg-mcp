# Comma-separated Gemini API keys in priority order (automatic failover if one fails/hits quota)
GEMINI_API_KEYS=your_primary_gemini_api_key_here,your_backup_gemini_api_key_here

# Or configure them individually:
# GEMINI_API_KEY=your_primary_gemini_api_key_here
# GEMINI_API_KEY_2=your_backup_gemini_api_key_here

# Gemini TTS configuration
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
DEFAULT_VOICE_ID=charon

# Server & download URL configuration
HOST=0.0.0.0
PORT=8080
# Set this in production if behind a custom domain or proxy (e.g. https://sg-mcp-xxxx.a.run.app)
# Leave empty to auto-detect from incoming request headers
PUBLIC_BASE_URL=

# Generated audio file storage & cleanup
AUDIO_STORAGE_DIR=./generated_audio
AUDIO_TTL_SECONDS=3600
MAX_STORED_FILES=200

# Optional: Protect /mcp endpoint with a static Bearer token (leave empty for public/no-auth testing)
MCP_AUTH_TOKEN=

# Optional: Set to false to omit inline base64 audio bytes from MCP ToolResult (still returns download URL)
INCLUDE_INLINE_AUDIO=true
